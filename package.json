{
  "name": "onrecord",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm test && node scripts/check-file-length.mjs && node scripts/check-invariants.mjs",
    "verify:fast": "pnpm typecheck && pnpm lint && vitest run --project unit && node scripts/check-file-length.mjs && node scripts/check-invariants.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:drift": "tsx scripts/schema-diff.ts",
    "db:seed": "tsx scripts/seed.ts",
    "digest:preview": "tsx scripts/digest-preview.ts",
    "e2e": "playwright test",
    "e2e:setup": "tsx scripts/e2e-setup.ts",
    "e2e:baseline": "PW_DESKTOP_COMPARE=1 playwright test --project=setup --project=desktop --update-snapshots=all",
    "e2e:compare": "PW_DESKTOP_COMPARE=1 playwright test --project=setup --project=desktop"
  },
  "dependencies": {
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.5",
    "next": "15.5.25",
    "postgres": "^3.4.7",
    "postmark": "^5.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
