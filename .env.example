# Direct connection to the crm-dev Supabase Postgres (port 5432).
# Use the host labeled "direct" in the Supabase connect dialog:
#   postgresql://postgres:[PASSWORD]@db.<ref>.supabase.co:5432/postgres
# Do not use the transaction pooler (*.pooler.supabase.com:6543).
# Never point this at the crm production project. CI uses the same crm-dev URL.
DATABASE_URL=
