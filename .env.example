# crm-dev only. Never point either URL at the crm production project.
#
# DATABASE_URL — Supavisor session pooler (port 5432).
# Used by db:migrate, db:seed, and local integration tests. CI uses a scratch database.
# Session mode supports DDL and prepared statements. Do not use 6543 here.
#   postgresql://postgres.<ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# DATABASE_POOLER_URL — Supavisor transaction pooler (port 6543).
# Used by the app runtime only. The runtime driver sets prepare: false.
# Transaction mode does not support prepared statements or reliable DDL.
#   postgresql://postgres.<ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
DATABASE_POOLER_URL=

# Signed session cookies. At least 32 characters. Never commit the real value.
SESSION_SECRET=

# Job cron. POST /api/cron/tick requires header x-cron-secret (or Authorization Bearer).
CRON_SECRET=

# Send kill switch. Must stay false until the S2 gate passes. Never set true in CI.
SEND_ENABLED=false
# Comma-separated recipient domains, or * only when VERCEL_ENV/NODE_ENV is production.
SEND_ALLOWLIST=

# Postmark. Tests use FakeMailer and must not set a real token.
# POST /api/webhooks/postmark requires x-postmark-webhook-secret (or Authorization Bearer).
POSTMARK_SERVER_TOKEN=
POSTMARK_WEBHOOK_SECRET=
# Verified From address on the monthly stream. Weekly is unused for now.
MAIL_FROM_MONTHLY=
MAIL_FROM_WEEKLY=
# Signed unsubscribe links. At least 32 characters. Never commit the real value.
# Tokens do not expire. An old email must still be able to unsubscribe.
UNSUBSCRIBE_SECRET=

# Stripe, test mode only. The app refuses any secret key that is not sk_test_.
# Tests use FakeBillingGateway and must not set a real key.
# POST /api/webhooks/stripe checks Stripe-Signature against STRIPE_WEBHOOK_SECRET (whsec_...); a bad one is a 404.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
