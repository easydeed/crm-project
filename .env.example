# crm-dev only. Never point either URL at the crm production project.
#
# DATABASE_URL — Supavisor session pooler (port 5432).
# Used by db:push, db:seed, CI, and constraint tests.
# Session mode supports DDL and prepared statements. Do not use 6543 here.
#   postgresql://postgres.<ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# DATABASE_POOLER_URL — Supavisor transaction pooler (port 6543).
# Used by the app runtime only. The runtime driver sets prepare: false.
# Transaction mode does not support prepared statements or reliable DDL.
#   postgresql://postgres.<ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
DATABASE_POOLER_URL=

# Signed session cookies. At least 32 characters. Never commit the real value.
SESSION_SECRET=

# Job cron. POST /api/cron/tick requires header x-cron-secret (or Authorization Bearer).
CRON_SECRET=

# Send kill switch. Must stay false until the S2 gate passes. Never set true in CI.
SEND_ENABLED=false
# Comma-separated recipient domains, or * only when VERCEL_ENV/NODE_ENV is production.
SEND_ALLOWLIST=
